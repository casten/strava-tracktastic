{
  "manifest_version": 3,
  "name": "Tracktastic for Strava",
  "version": "1.0.0",
  "description": "Shows Strava lap and interval distances in meters, rounded to the nearest 50 m, for track workouts.",
  "author": "Casten Riepling",
  "homepage_url": "https://github.com/casten/strava-tracktastic",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.strava.com/activities/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tracktastic for Strava",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
